# PolyDoc MCP server configuration (set these in your MCP client's server env).

# Required. Create a key at https://dashboard.polydoc.tech under API Keys.
POLYDOC_API_KEY=

# Optional. Run conversions in sandbox mode by default (watermarked, higher quota,
# rate-limited to about 5 requests/sec). A tool call can override this per request.
POLYDOC_SANDBOX=false

# Optional. Override only for self-hosted or staging environments.
POLYDOC_BASE_URL=https://api.polydoc.tech

# Optional. Directory that downloaded files are written into. Defaults to a
# "polydoc" folder under the OS temp directory. Output never escapes this folder.
POLYDOC_OUTPUT_DIR=
